# =====================================================================
#  MonCheptel - secrets locaux (SMTP)
#
#  MODE D'EMPLOI
#    1. Copiez ce fichier SOUS LE NOM  application.properties  dans le
#       meme dossier (api/config/). Le nom exact compte.
#    2. Remplacez les valeurs ci-dessous. Pas de guillemets, pas
#       d'espace avant ni apres le signe =.
#    3. Relancez le back. Aucun autre reglage.
#
#  CE FICHIER-CI (.exemple) NE CONTIENT AUCUN SECRET et peut etre
#  commite. application.properties, lui, est exclu par .gitignore :
#  ne le copiez jamais ailleurs, ne l'envoyez a personne, ne le collez
#  jamais dans une conversation.
#
#  Spring Boot lit ./config/application.properties depuis le dossier
#  d'ou le back est lance (ici : api). Ce fichier PREND LE PAS sur
#  application.yml, donc sur les variables MONCHEPTEL_SMTP_*.
#
#  Gmail : le mot de passe est un MOT DE PASSE D'APPLICATION (16
#  caracteres, espaces retires), pas le mot de passe du compte.
# =====================================================================

spring.mail.username=votre.adresse@gmail.com
spring.mail.password=mot-de-passe-application-16-caracteres

# Doit etre la meme adresse que spring.mail.username avec Gmail.
moncheptel.courriel.expediteur=votre.adresse@gmail.com

# ---------------------------------------------------------------------
#  PREMIER ADMINISTRATEUR (facultatif, audit global G1)
#
#  Une base SANS le jeu de demonstration n'a aucun administrateur. Au
#  demarrage, si AUCUN administrateur n'existe et que ces deux lignes
#  sont renseignees, le back cree le compte avec ce mot de passe
#  PROVISOIRE : a la premiere connexion, la console impose de le
#  changer, et le serveur refuse toute autre route d'ici la.
#  Mot de passe : 12 a 72 caracteres. Il n'est jamais journalise.
#
#  S'il existe deja un administrateur (base de demonstration comprise),
#  ces lignes sont ignorees et rien n'est modifie.
#  UNE FOIS LE COMPTE CREE, RETIREZ-LES (ou videz-les).
#
#  Equivalents en variables d'environnement : MONCHEPTEL_ADMIN_EMAIL,
#  MONCHEPTEL_ADMIN_MOT_DE_PASSE_INITIAL, MONCHEPTEL_ADMIN_NOM.
# ---------------------------------------------------------------------

#moncheptel.administrateur-initial.email=direction@votre-domaine.ml
#moncheptel.administrateur-initial.mot-de-passe=a-remplacer-au-moins-12-caracteres
#moncheptel.administrateur-initial.nom=Administrateur

# ---------------------------------------------------------------------
#  LIMITE DE DEBIT (audit global G2) : active par defaut. A couper
#  seulement pour derouler test-back-complet.ps1, qui se connecte des
#  dizaines de fois en quelques minutes. Jamais en production.
# ---------------------------------------------------------------------

#moncheptel.limite-debit.actif=false
