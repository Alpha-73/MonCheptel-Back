<?xml version="1.0" encoding="UTF-8"?>
<!--
  Journaux de MonCheptel API (audit global G20).

  - Profil dev (et tests) : console seule, comme avant.
  - Tout autre profil (production) : console ET fichier tournant
      ${MONCHEPTEL_JOURNAUX}/moncheptel-api.log   (defaut : ./journaux)
    un fichier par jour, coupe a 20 Mo, garde 30 jours, 1 Go au plus.

  Les niveaux restent ceux de application.yml (logging.level.*). La trace
  SQL avec valeurs (org.hibernate.orm.jdbc.bind: TRACE) n'est activee que
  par application-dev.yml : elle n'existe pas en production.
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

  <springProperty scope="context" name="DOSSIER" source="moncheptel.journaux.dossier"
                  defaultValue="journaux"/>

  <springProfile name="dev | test">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>

  <springProfile name="!dev &amp; !test">
    <appender name="FICHIER" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <file>${DOSSIER}/moncheptel-api.log</file>
      <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
        <fileNamePattern>${DOSSIER}/moncheptel-api.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
        <maxFileSize>20MB</maxFileSize>
        <maxHistory>30</maxHistory>
        <totalSizeCap>1GB</totalSizeCap>
      </rollingPolicy>
      <encoder>
        <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
        <charset>UTF-8</charset>
      </encoder>
    </appender>
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="FICHIER"/>
    </root>
  </springProfile>
</configuration>
